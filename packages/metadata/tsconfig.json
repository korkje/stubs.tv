{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is here only for the fetch/URL web APIs, which exist in both the
    // Workers runtime and Node — this package touches no browser globals.
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
