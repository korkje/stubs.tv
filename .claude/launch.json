{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "apps/web"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-oauth",
      "runtimeExecutable": "env",
      "runtimeArgs": ["AUTH_PROVIDERS=google,apple", "npm", "run", "dev", "--workspace", "apps/web"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-selfhosted",
      "runtimeExecutable": "env",
      "runtimeArgs": ["SELF_HOSTED=true", "npm", "run", "dev", "--workspace", "apps/web"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-turnstile",
      "runtimeExecutable": "env",
      "runtimeArgs": ["TURNSTILE_SITE_KEY=1x00000000000000000000AA", "npm", "run", "dev", "--workspace", "apps/web"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-turnstile-challenge",
      "runtimeExecutable": "env",
      "runtimeArgs": ["TURNSTILE_SITE_KEY=3x00000000000000000000FF", "npm", "run", "dev", "--workspace", "apps/web"],
      "port": 3000,
      "autoPort": true
    }
  ]
}
