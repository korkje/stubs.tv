# Self-hosting with Docker Compose — copy to `.env` (docs/SELF-HOSTING.md).
# For local development use apps/web/.env.example instead.

# Your Supabase project (hosted at supabase.com, or your own instance).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret (service_role) key — server-only, bypasses row level security.
SUPABASE_SECRET_KEY=

# TheTVDB v4 API key: https://thetvdb.com/api-information
TVDB_API_KEY=

# Any long random string; guards the background-job routes.
# e.g. `openssl rand -hex 32`
CRON_SECRET=

# Removes the paywall (ADR-0019). Leave true for a self-hosted instance.
SELF_HOSTED=true

# Optional: OAuth providers to offer ("google", "apple", or both), which
# must also be configured on the Supabase project.
# AUTH_PROVIDERS=

# Optional: host port to publish the app on (container always uses 3000).
# STUBS_PORT=3000
