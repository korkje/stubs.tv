# Copy to .env.local for development.
# Local values come from `supabase start` output (run from the repo root).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TheTVDB v4 API key (https://thetvdb.com/api-information) — used from Phase 1.
TVDB_API_KEY=

# Supabase secret (service_role) key — server-only, used for metadata
# ingestion writes. Local value: the SECRET_KEY from `npx supabase status`.
# In production this is a Cloudflare worker secret, never a GitHub variable.
SUPABASE_SECRET_KEY=
