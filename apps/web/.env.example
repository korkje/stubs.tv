# Copy to .env.local for development.
# Local values come from `supabase start` output (run from the repo root).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TheTVDB v4 API key (https://thetvdb.com/api-information) — used from Phase 1.
TVDB_API_KEY=

# Supabase secret (service_role) key — server-only, used for metadata
# ingestion writes. Local value: the SECRET_KEY from `npx supabase status`.
# In production this is a Cloudflare worker secret, never a GitHub variable.
SUPABASE_SECRET_KEY=

# Motion+ access token (https://motion.dev/dashboard/tokens). Authenticates
# against Motion+'s private npm registry — see .npmrc — so `npm ci` needs it
# exported, not just present here:
#   export $(grep MOTION_TOKEN apps/web/.env.local)
# In CI it is the MOTION_TOKEN repo secret.
MOTION_TOKEN=

# Guards /api/refresh, the hourly metadata refresh the worker's cron trigger
# invokes (ADR-0010). Any long random string locally; in production a
# Cloudflare worker secret.
CRON_SECRET=
