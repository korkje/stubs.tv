# Copy to .env.local for development.
# Local values come from `supabase start` output (run from the repo root).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TheTVDB v4 API key (https://thetvdb.com/api-information) — used from Phase 1.
TVDB_API_KEY=

# Supabase secret (service_role) key — server-only, used for metadata
# ingestion writes. Local value: the SECRET_KEY from `npx supabase status`.
# In production this is a Cloudflare worker secret, never a GitHub variable.
SUPABASE_SECRET_KEY=

# Guards /api/refresh, the hourly metadata refresh the worker's cron trigger
# invokes (ADR-0010). Any long random string locally; in production a
# Cloudflare worker secret.
CRON_SECRET=

# OAuth providers to offer on login/signup ("google,apple" in production —
# see docs/plans/oauth-login.md). Leave unset for password/email only; the
# providers must be configured on the Supabase project to actually work.
AUTH_PROVIDERS=

# Self-hosted mode (ADR-0019): set to `true` to remove the paywall — every
# signed-in account gets full access and the pricing/billing UI disappears,
# so none of the Polar keys below are needed. Set it wherever the server
# code runs: .env.local for dev; for a Workers deploy both in the build
# environment (prerendered pages read it at build time) and in
# wrangler.jsonc `vars`.
SELF_HOSTED=

# Polar (payments) — token from https://polar.sh/dashboard/stubs-tv/settings
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox

# Polar product ids (per environment — sandbox and production ids differ;
# production values live in wrangler.jsonc vars, they are not secret)
POLAR_PRODUCT_MONTHLY=
POLAR_PRODUCT_ANNUAL=
POLAR_PRODUCT_LIFETIME=
